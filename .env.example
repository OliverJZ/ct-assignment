# Application mode
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ct_assignment
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ct_assignment?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Redpanda / Kafka
REDPANDA_EXTERNAL_PORT=19092
REDPANDA_ADMIN_PORT=9644
REDPANDA_BROKERS=localhost:19092
REVIEW_EVENTS_TOPIC=review-events
REVIEW_EVENTS_PARTITIONS=4
REVIEW_CONSUMER_GROUP=review-processor

# Service ports
PRODUCT_SERVICE_PORT=3000
REVIEW_PROCESSOR_PORT=3001

# Observability
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002
LOKI_PORT=3100
TEMPO_PORT=3200
