{
  "name": "ct-assignment",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:product": "npm run build --workspace @ct/product-service",
    "build:processor": "npm run build --workspace @ct/review-processor-service",
    "dev:product": "npm run start:dev --workspace @ct/product-service",
    "dev:processor": "npm run start:dev --workspace @ct/review-processor-service",
    "lint": "npm run lint --workspaces --if-present",
    "lint:product": "npm run lint --workspace @ct/product-service",
    "lint:processor": "npm run lint --workspace @ct/review-processor-service",
    "test": "npm run test --workspaces --if-present",
    "test:product": "npm run test --workspace @ct/product-service",
    "test:processor": "npm run test --workspace @ct/review-processor-service",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prisma:generate": "prisma generate --schema packages/shared/prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema packages/shared/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema packages/shared/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema packages/shared/prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema packages/shared/prisma/schema.prisma",
    "demo:traffic": "node infra/scripts/demo-traffic.mjs",
    "compose:infra": "docker compose up -d postgres redis redpanda",
    "compose:observability": "docker compose --profile observability up -d prometheus tempo otel-collector grafana",
    "topic:describe": "docker compose exec redpanda rpk topic describe review-events",
    "topic:ensure": "bash infra/scripts/ensure-review-events-topic.sh",
    "group:describe": "docker compose exec redpanda rpk group describe review-processor",
    "compose:full": "docker compose --profile observability up --build -d",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "prisma": "^6.16.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.1"
  }
}
