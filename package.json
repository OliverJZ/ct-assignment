{
  "name": "ct-assignment",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:product": "npm run start:dev --workspace @ct/product-service",
    "dev:processor": "npm run start:dev --workspace @ct/review-processor-service",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down -v"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.24.1"
  }
}
